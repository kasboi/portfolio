---
/**
 * Footer Component
 * Displays copyright, social links, and navigation
 */
const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: "GitHub",
    url: "https://github.com/kasboi",
    icon: "logo-github",
  },
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/abdullah-solahudeen/",
    icon: "logo-linkedin",
  },
  {
    name: "CodePen",
    url: "https://codepen.io/kolawole-abdullah-solahudeen",
    icon: "logo-codepen",
  },
];

const navLinks = [
  { name: "Home", href: "#home" },
  { name: "About", href: "#about" },
  { name: "Projects", href: "#projects" },
  { name: "Contact", href: "#contact" },
];
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-main">
      <div class="footer-brand">
        <span class="footer-logo">KAS</span>
        <p class="footer-tagline">Building digital experiences with code & creativity</p>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <ul class="footer-links">
          {navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.name}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-social">
        {socialLinks.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label={`Visit ${social.name} profile`}
          >
            <ion-icon name={social.icon}></ion-icon>
          </a>
        ))}
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} Kolawole Abdullah. All rights reserved.
      </p>
      <p class="built-with">
        Built with <span class="heart" aria-label="love">♥</span> using Astro
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-secondary, #1a1a2e);
    padding: 3rem 0 1.5rem;
    margin-top: 4rem;
    position: relative;
    overflow: hidden;
  }

  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent-color, #9c36b5),
      transparent
    );
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: center;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-brand {
    text-align: left;
  }

  .footer-logo {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--accent-color, #9c36b5);
    letter-spacing: 0.05em;
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--font-secondary, #888);
    margin-top: 0.5rem;
    opacity: 0.8;
  }

  .footer-nav {
    justify-self: center;
  }

  .footer-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links a {
    color: var(--font-secondary, #888);
    font-size: 0.9rem;
    transition: color 0.2s ease;
    position: relative;
  }

  .footer-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--accent-color, #9c36b5);
    transition: width 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--font-primary, #fff);
  }

  .footer-links a:hover::after {
    width: 100%;
  }

  .footer-social {
    display: flex;
    gap: 1rem;
    justify-self: end;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: var(--font-secondary, #888);
    transition: all 0.3s ease;
  }

  .social-link ion-icon {
    font-size: 20px;
    color: inherit;
    margin: 0;
  }

  .social-link:hover {
    background: var(--accent-color, #9c36b5);
    color: #fff;
    transform: translateY(-3px);
  }

  .social-link:hover ion-icon {
    color: #fff;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--font-secondary, #888);
  }

  .copyright {
    opacity: 0.7;
  }

  .built-with {
    opacity: 0.7;
  }

  .heart {
    color: #e74c3c;
    animation: heartbeat 1.5s infinite;
  }

  @keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .footer {
      padding: 2rem 0 1rem;
    }

    .footer-content {
      padding: 0 1rem;
    }

    .footer-main {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 1.5rem;
    }

    .footer-brand {
      text-align: center;
    }

    .footer-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem 1.5rem;
    }

    .footer-social {
      justify-self: center;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .footer-logo {
      font-size: 1.5rem;
    }

    .footer-links {
      gap: 0.75rem 1rem;
    }
  }
</style>
