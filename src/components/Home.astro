---
/**
 * Home/Hero Section Component
 * Displays the main hero section with greeting and profile image
 * This is a static component - no JavaScript hydration needed
 */

interface Props {
  name?: string;
  fullName?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  name = "KAS",
  fullName = "Kolawole Abdullah Solahudeen",
  imageSrc = "/img/kasSelfie.jpeg",
  imageAlt = "KAS Profile Picture"
} = Astro.props;
---

<section class="home-container" id="home">
  <div class="text-container">
    <h1>Hello, I'm {name}</h1>
    <h4>{fullName}</h4>
    <p>
      I am a Software Engineer with over 4 years of experience using
      front-end technologies to create web applications. I am also familiar
      with back-end tools and have experience with Agile methodologies and
      Software Development Life Cycles. I have a strong background in
      Javascript, Typescript, React and Next.js framework.
    </p>
    <p>
      I can be relied on to use critical thinking to solve complex projects.
      During my free hours, I indulge in manga, anime, music, or geeking
      about emerging tech.
    </p>
    <p>
      Let's work together to bring your vision to life! I am available for
      both contract and full-time remote positions.
    </p>
  </div>
  <div class="image-container">
    <img 
      src={imageSrc} 
      alt={imageAlt}
      class="display-img"
      loading="eager"
      decoding="async"
    />
  </div>
</section>

<style>
  .home-container {
    display: flex;
    padding: 0 4rem;
    align-items: center;
    justify-content: space-between;
    min-height: 80vh;
  }

  @media (max-width: 1024px) {
    .home-container {
      padding: 0 2.5rem;
    }
  }

  @media (max-width: 768px) {
    .home-container {
      padding: 0 2rem;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
    }
  }

  @media (max-width: 600px) {
    .home-container {
      padding: 0 1.35rem;
    }
  }

  @media (max-width: 425px) {
    .home-container {
      padding: 0 1rem;
    }
  }

  .text-container {
    display: block;
    max-width: 55%;
    color: var(--font-primary);
  }

  @media (max-width: 768px) {
    .text-container {
      max-width: 100%;
      margin-bottom: 2rem;
      text-align: left;
    }
  }

  @media (max-width: 425px) {
    .text-container {
      text-align: left;
    }
  }

  .text-container h1 {
    color: var(--logo-color);
    font-size: 3rem;
    letter-spacing: 0.06em;
    margin-bottom: 0.5rem;
  }

  .text-container h4 {
    font-weight: 500;
    font-size: 1.45rem;
    margin-bottom: 1.3rem;
  }

  @media (max-width: 425px) {
    .text-container h4 {
      font-size: 1rem;
    }
  }

  .text-container p {
    font-weight: var(--font-weight);
    margin: 0.5rem 0;
  }

  @media (max-width: 768px) {
    .text-container p {
      line-height: normal;
    }
  }

  @media (max-width: 600px) {
    .text-container p {
      font-size: 0.9rem;
    }
  }

  .image-container {
    position: relative;
    border: 2px solid var(--logo-color);
    height: 15rem;
    width: 14rem;
    border-radius: 5px;
    animation: fadeIn 1s ease-in 1s both;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .image-container {
      margin: 0 auto;
    }
  }

  .display-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 5px;
    transform: translate(-18px, -18px);
    transition: transform 0.3s ease-in-out;
  }

  .display-img:hover {
    transform: translate(0, 0);
  }
</style>
