---
/**
 * Projects Section Component
 * Displays project cards in a grid layout
 * This is a static component - data is rendered at build time
 */

interface Project {
  liveLink: string;
  gitLink: string;
  projectName: string;
  projectDesc: string;
  technologies: string[];
}

interface Props {
  projects?: Project[];
}

// Default project data - can be overridden via props or later migrated to content collections
const defaultProjects: Project[] = [
  {
    liveLink: "https://navigate-jade.vercel.app/",
    gitLink: "https://github.com/kasboi/navigate",
    projectName: "Navigate - Urban Areas",
    projectDesc: "An open source project for discovering quality of life and average salaries for various job sectors in urban areas. Includes search, filter, pictures, score of living, infinite scroll amongst other features.",
    technologies: ["Typescript", "Next.js", "React", "Teleport Open API"]
  },
  {
    liveLink: "https://ts-weather-forecast.netlify.app/",
    gitLink: "https://github.com/kasboi/React-Weather-App-Typescript#",
    projectName: "Weather Forecast",
    projectDesc: "A 5-day weather forecast web app. This project Consumes 2 APIs [GeoDB & Openweathermap] to accurately determine the latitude and longitude of cities and their weather report for the next 5 days.",
    technologies: ["Typescript", "React", "API"]
  },
  {
    liveLink: "https://kas-notesapp.netlify.app/",
    gitLink: "https://github.com/kasboi/notes_app",
    projectName: "Note Keeper",
    projectDesc: "Fullstack web app for note taking and tracking. Equiped with Firebase services (authentication & firestore).",
    technologies: ["Javascript", "React", "Firebase", "Material UI"]
  },
  {
    liveLink: "https://codepen.io/kolawole-abdullah-solahudeen/pen/BaJzjoN",
    gitLink: "#",
    projectName: "Tic-Tac Toe",
    projectDesc: "A beautiful and simple re-creation of the popular 3x3 tic-tac toe game.",
    technologies: ["Javascript", "HTML", "CSS"]
  },
  {
    liveLink: "https://monster-btc.netlify.app/",
    gitLink: "https://github.com/kasboi/monster",
    projectName: "Monster Finance",
    projectDesc: "A responsive landing page demo for a blockchain project.",
    technologies: ["Javascript", "HTML", "CSS"]
  },
  {
    liveLink: "https://asalytics-test-six.vercel.app/",
    gitLink: "https://github.com/kasboi/asalytics-test",
    projectName: "Analytics",
    projectDesc: "Web application for keeping track of availablity of crypto coins built on top of the Next.js framework + Typescript.",
    technologies: ["Typescript", "React", "Next.js", "Jest"]
  },
  {
    liveLink: "https://guitarclub.netlify.app/",
    gitLink: "https://github.com/kasboi/guitar",
    projectName: "Guitar Club",
    projectDesc: "A small responsive website i made early on while fiddling with SCSS.",
    technologies: ["Javascript", "HTML", "SCSS"]
  },
  {
    liveLink: "https://ecstatic-volhard-ea4bc9.netlify.app/",
    gitLink: "#",
    projectName: "Ace Blog",
    projectDesc: "A simple blog that consumes API and uses it to display various news articles.",
    technologies: ["Javascript", "HTML", "CSS"]
  },
  {
    liveLink: "https://codepen.io/kolawole-abdullah-solahudeen/pen/dyJXGGa/",
    gitLink: "#",
    projectName: "Calculator",
    projectDesc: "Simple calculator app.",
    technologies: ["Javascript", "HTML", "CSS"]
  },
];

const { projects = defaultProjects } = Astro.props;
---

<section class="projects-container" id="projects">
  <h3 class="projects-heading">Projects</h3>
  <div class="projects-grid">
    {projects.map((project) => (
      <article class="project-card">
        <div class="card-icons">
          <svg 
            class="folder-icon" 
            viewBox="0 0 24 24" 
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
          </svg>
          <div class="card-links">
            <a 
              href={project.liveLink} 
              rel="noreferrer" 
              target="_blank"
              aria-label={`View live demo of ${project.projectName}`}
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/>
              </svg>
            </a>
            {project.gitLink !== "#" && (
              <a 
                href={project.gitLink} 
                rel="noreferrer"
                target="_blank"
                aria-label={`View source code of ${project.projectName} on GitHub`}
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
            )}
          </div>
        </div>
        <h2 class="card-title">{project.projectName}</h2>
        <p class="card-description">{project.projectDesc}</p>
        <ul class="card-technologies">
          {project.technologies.map((tech) => (
            <li class="tech-tag">-{tech}-</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>

<style>
  .projects-container {
    max-width: 90%;
    margin: 0 auto;
    z-index: -100;
    color: var(--font-secondary);
    /* Scroll-based fade-in animation */
    animation: scrollFadeIn 0.4s ease-in both;
    animation-timeline: view();
    animation-range: entry 0% entry 30%;
  }

  @keyframes scrollFadeIn {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .projects-heading {
    position: relative;
    font-weight: 500;
    margin-bottom: 2rem;
    text-transform: uppercase;
    color: var(--logo-color);
  }

  .projects-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 1rem;
  }

  .project-card {
    padding: 1.35rem 1.5rem;
    flex: 1 0 31%;
    border-radius: 5px;
    border: 2px solid gray;
    background: var(--modal-primary);
  }

  @media (max-width: 1024px) {
    .project-card {
      flex: 1 0 32%;
    }
  }

  @media (max-width: 768px) {
    .project-card {
      flex: 1 0 45%;
    }
  }

  @media (max-width: 600px) {
    .project-card {
      flex: 1 0 100%;
    }
  }

  .card-icons {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
  }

  .folder-icon {
    width: 4rem;
    height: 4rem;
    margin-right: auto;
    color: var(--font-secondary);
  }

  .card-links {
    display: flex;
    gap: 0.5rem;
  }

  .card-links a {
    display: flex;
    color: var(--font-secondary);
    transition: color 0.2s ease;
  }

  .card-links a:hover {
    color: var(--logo-color);
  }

  .card-links svg {
    width: 2rem;
    height: 2rem;
  }

  .card-title {
    color: var(--font-primary);
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .card-description {
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1rem;
    color: var(--font-secondary);
  }

  .card-technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .tech-tag {
    font-size: 0.75rem;
    color: var(--font-tertiary);
    font-weight: 500;
  }
</style>
