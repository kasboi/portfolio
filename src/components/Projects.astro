---
/**
 * Projects Section Component
 * Modern card-based layout with featured projects and hover effects
 * Follows Web Interface Guidelines for accessibility and interactions
 */
import { getCollection } from "astro:content";

// Fetch projects from content collection and sort by order
const projectEntries = await getCollection("projects");
const projects = projectEntries
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .map((entry) => ({
    liveLink: entry.data.liveLink,
    gitLink: entry.data.gitLink,
    projectName: entry.data.title,
    projectDesc: entry.data.description,
    technologies: entry.data.technologies,
    featured: entry.data.featured ?? false,
    slug: entry.slug,
  }));

// Separate featured and regular projects
const featuredProjects = projects.filter(p => p.featured);
const regularProjects = projects.filter(p => !p.featured);
---

<section class="projects-section" id="projects">
  <div class="section-header">
    <h2 class="section-title">
      <span class="title-accent">Featured</span> Projects
    </h2>
    <p class="section-subtitle">A selection of work I'm proud of</p>
  </div>

  {/* Featured Projects - Larger Cards */}
  {featuredProjects.length > 0 && (
    <div class="featured-grid">
      {featuredProjects.map((project, index) => (
        <article 
          class="project-card featured-card"
          style={`--animation-delay: ${index * 0.1}s`}
        >
          <div class="card-glow" aria-hidden="true"></div>
          <div class="card-content">
            <div class="card-header">
              <div class="card-badge">Featured</div>
              <div class="card-actions">
                <a 
                  href={project.liveLink} 
                  target="_blank"
                  rel="noopener noreferrer"
                  class="action-link"
                  aria-label={`View live demo of ${project.projectName}`}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                    <polyline points="15 3 21 3 21 9"/>
                    <line x1="10" y1="14" x2="21" y2="3"/>
                  </svg>
                </a>
                {project.gitLink !== "#" && (
                  <a 
                    href={project.gitLink} 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="action-link"
                    aria-label={`View source code of ${project.projectName} on GitHub`}
                  >
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>
            <h3 class="card-title">{project.projectName}</h3>
            <p class="card-description">{project.projectDesc}</p>
            <ul class="tech-stack" aria-label="Technologies used">
              {project.technologies.map((tech) => (
                <li class="tech-pill">{tech}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  )}

  {/* Other Projects */}
  {regularProjects.length > 0 && (
    <>
      <h3 class="other-projects-title">Other Projects</h3>
      <div class="projects-grid">
        {regularProjects.map((project, index) => (
          <article 
            class="project-card"
            style={`--animation-delay: ${(featuredProjects.length + index) * 0.05}s`}
          >
            <div class="card-content">
              <div class="card-header">
                <svg class="folder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div class="card-actions">
                  <a 
                    href={project.liveLink} 
                    target="_blank"
                    rel="noopener noreferrer"
                    class="action-link"
                    aria-label={`View live demo of ${project.projectName}`}
                  >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                      <polyline points="15 3 21 3 21 9"/>
                      <line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                  </a>
                  {project.gitLink !== "#" && (
                    <a 
                      href={project.gitLink} 
                      target="_blank"
                      rel="noopener noreferrer"
                      class="action-link"
                      aria-label={`View source code of ${project.projectName} on GitHub`}
                    >
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                      </svg>
                    </a>
                  )}
                </div>
              </div>
              <h3 class="card-title">{project.projectName}</h3>
              <p class="card-description">{project.projectDesc}</p>
              <ul class="tech-stack" aria-label="Technologies used">
                {project.technologies.map((tech) => (
                  <li class="tech-pill">{tech}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </>
  )}
</section>

<style>
  /* Section Layout */
  .projects-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  /* Section Header */
  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    color: var(--font-primary);
    margin-bottom: 0.5rem;
    text-wrap: balance;
  }

  .title-accent {
    color: var(--logo-color);
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--font-secondary);
    margin: 0;
  }

  /* Featured Grid - Larger Cards */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  /* Regular Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .other-projects-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--font-secondary);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Card Base */
  .project-card {
    position: relative;
    background: var(--modal-primary);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    animation: cardFadeIn 0.5s ease both;
    animation-delay: var(--animation-delay, 0s);
  }

  @keyframes cardFadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Scroll-based animation */
  @supports (animation-timeline: view()) {
    .project-card {
      animation: scrollCardIn 0.4s ease-out both;
      animation-timeline: view();
      animation-range: entry 10% entry 40%;
    }

    @keyframes scrollCardIn {
      from {
        opacity: 0;
        transform: translateY(30px) scale(0.95);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
  }

  .project-card:hover {
    transform: translateY(-8px);
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.1),
      0 0 0 1px var(--logo-color);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      animation: none;
      opacity: 1;
      transform: none;
    }
    
    .project-card:hover {
      transform: none;
    }
  }

  /* Featured Card Glow Effect */
  .featured-card {
    border: 1px solid transparent;
    background: 
      linear-gradient(var(--modal-primary), var(--modal-primary)) padding-box,
      linear-gradient(135deg, var(--logo-color) 0%, transparent 50%, var(--logo-color) 100%) border-box;
  }

  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--logo-color), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .featured-card:hover .card-glow {
    opacity: 1;
  }

  /* Card Content */
  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 220px;
  }

  .featured-card .card-content {
    min-height: 260px;
  }

  /* Card Header */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .card-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--logo-color);
    background: rgba(156, 54, 181, 0.15);
    padding: 0.35rem 0.75rem;
    border-radius: 100px;
  }

  .folder-icon {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--logo-color);
    opacity: 0.8;
  }

  /* Card Actions */
  .card-actions {
    display: flex;
    gap: 0.75rem;
  }

  .action-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    color: var(--font-secondary);
    background: transparent;
    transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
  }

  .action-link:hover {
    color: var(--logo-color);
    background: rgba(156, 54, 181, 0.1);
    transform: translateY(-2px);
  }

  .action-link:focus-visible {
    outline: 2px solid var(--logo-color);
    outline-offset: 2px;
  }

  .action-link svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Card Title */
  .card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--font-primary);
    margin: 0 0 0.75rem 0;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .project-card:hover .card-title {
    color: var(--logo-color);
  }

  .featured-card .card-title {
    font-size: 1.25rem;
  }

  /* Card Description */
  .card-description {
    font-size: 0.875rem;
    color: var(--font-secondary);
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-card .card-description {
    -webkit-line-clamp: 5;
  }

  /* Tech Stack */
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0 0;
  }

  .tech-pill {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--font-tertiary);
    background: rgba(156, 54, 181, 0.08);
    padding: 0.35rem 0.75rem;
    border-radius: 100px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .project-card:hover .tech-pill {
    background: rgba(156, 54, 181, 0.15);
    color: var(--logo-color);
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .projects-section {
      padding: 1.5rem 1rem;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .featured-grid {
      grid-template-columns: 1fr;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .card-content {
      padding: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .section-title {
      font-size: 1.5rem;
    }

    .card-title {
      font-size: 1rem;
    }

    .featured-card .card-title {
      font-size: 1.125rem;
    }
  }
</style>